# macOS and editors
.DS_Store
*.swp
*.swo

# Private, large reference originals; keep the manifest instead
/TEST/

# Derived or temporary outputs
/scratch/
/output/
/build/
/DerivedData/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate
*.xcarchive
*.dSYM/

# Runtime roll state must not become repository fixtures by accident
.printroom.json
.printroom-cache/

# Local environment
.env
.env.*
!.env.example

# Python bytecode cache generated by local asset scripts
/scripts/__pycache__/

# Local agent instructions, development history and private study reports.
# Keep these files on disk; only the current technical docs are shared.
/AGENTS.md
/docs/acceptance-*.md
/docs/decisions.md
/docs/roadmap.md
/docs/validation.md
/docs/product.md
/docs/raw-*.md
/docs/*.json
/docs/local/

# Historical local experiments; not required to build or run regression tests.
/scripts/raw-adobe-study/
/scripts/raw-lowres-study/
/scripts/autocrop-study/
/scripts/archive/white-compensation/
**/__pycache__/
*.pyc
