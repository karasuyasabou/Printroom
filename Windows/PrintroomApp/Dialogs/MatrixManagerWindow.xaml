<Window x:Class="PrintroomApp.Dialogs.MatrixManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理矩阵"
        Width="680" Height="520"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleHeaderText" Grid.Column="0"
                       Text="管理密度矩阵"
                       FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button x:Name="DoneBtn" Grid.Column="1" Content="完成"
                    Style="{StaticResource ToolbarNeutralButtonStyle}"
                    MinWidth="68" IsCancel="True"
                    Click="DoneBtn_Click"/>
        </Grid>

        <!-- Matrix Library Error Banner -->
        <StackPanel x:Name="LibraryErrorPanel" Grid.Row="1" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="LibraryErrorText"
                       Foreground="{DynamicResource RedChannelBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Button x:Name="ReloadLibraryBtn" Content="重新载入"
                    Style="{StaticResource ToolbarNeutralButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="ReloadLibraryBtn_Click"/>
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Preset List + Add/Duplicate/Delete -->
            <Grid x:Name="LeftColumn" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0.75"
                        CornerRadius="6"
                        Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PresetListPanel"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="NewDraftBtn" Content="新增"
                            Style="{StaticResource ToolbarNeutralButtonStyle}"
                            Height="25" Padding="10,2" Margin="0,0,6,0"
                            Click="NewDraftBtn_Click"/>
                    <Button x:Name="DuplicateBtn" Content="复制"
                            Style="{StaticResource ToolbarNeutralButtonStyle}"
                            Height="25" Padding="10,2" Margin="0,0,6,0"
                            Click="DuplicateBtn_Click"/>
                    <Button x:Name="DeleteBtn" Content="删除"
                            Style="{StaticResource ToolbarNeutralButtonStyle}"
                            Foreground="{DynamicResource RedChannelBrush}"
                            Height="25" Padding="10,2"
                            Click="DeleteBtn_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Width="1" Margin="18,0" Background="{DynamicResource SeparatorBrush}"/>

            <!-- Right Column: Matrix Editor -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Matrix Name with Watermark -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource ThemedTextBoxStyle}"
                             Height="28" VerticalContentAlignment="Center"
                             FontSize="12.5" MaxLength="80"
                             TextChanged="NameBox_TextChanged"/>
                    <TextBlock x:Name="NameWatermark"
                               Text="矩阵名称"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               FontSize="12.5"
                               Margin="8,0,8,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>

                <!-- CMOS Calibration Button -->
                <Button x:Name="SelectCmosBtn" Grid.Row="1"
                        Content="选择三张 TIFF / RAW…"
                        Style="{StaticResource ToolbarNeutralButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,14"
                        Visibility="Collapsed"
                        Click="SelectCmosBtn_Click"/>

                <!-- 3x3 Coefficients Grid -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="输入 R" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="输入 G" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="输入 B" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="输出 R′" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="输出 G′" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="输出 B′" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <TextBox x:Name="Cell0" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Style="{StaticResource ThemedTextBoxStyle}" TextChanged="Cell_TextChanged"/>
                    <TextBox x:Name="Cell1" Grid.Row="1" Grid.Column="2" Margin="0,0,8,6" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Style="{StaticResource ThemedTextBoxStyle}" TextChanged="Cell_TextChanged"/>
                    <TextBox x:Name="Cell2" Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Style="{StaticResource ThemedTextBoxStyle}" TextChanged="Cell_TextChanged"/>

                    <TextBox x:Name="Cell3" Grid.Row="2" Grid.Column="1" Margin="0,0,8,6" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Style="{StaticResource ThemedTextBoxStyle}" TextChanged="Cell_TextChanged"/>
                    <TextBox x:Name="Cell4" Grid.Row="2" Grid.Column="2" Margin="0,0,8,6" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Style="{StaticResource ThemedTextBoxStyle}" TextChanged="Cell_TextChanged"/>
                    <TextBox x:Name="Cell5" Grid.Row="2" Grid.Column="3" Margin="0,0,0,6" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Style="{StaticResource ThemedTextBoxStyle}" TextChanged="Cell_TextChanged"/>

                    <TextBox x:Name="Cell6" Grid.Row="3" Grid.Column="1" Margin="0,0,8,0" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Style="{StaticResource ThemedTextBoxStyle}" TextChanged="Cell_TextChanged"/>
                    <TextBox x:Name="Cell7" Grid.Row="3" Grid.Column="2" Margin="0,0,8,0" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Style="{StaticResource ThemedTextBoxStyle}" TextChanged="Cell_TextChanged"/>
                    <TextBox x:Name="Cell8" Grid.Row="3" Grid.Column="3" Margin="0,0,0,0" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Style="{StaticResource ThemedTextBoxStyle}" TextChanged="Cell_TextChanged"/>
                </Grid>

                <!-- Density Paste + CMOS Identifications -->
                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                    <Button x:Name="PasteBtn" Content="粘贴 3×3 系数"
                            Style="{StaticResource ToolbarNeutralButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Click="PasteBtn_Click"/>
                    <StackPanel x:Name="IdentificationsPanel"/>
                </StackPanel>

                <!-- Status / Failure -->
                <StackPanel Grid.Row="5" Margin="0,0,0,12">
                    <TextBlock x:Name="FailureText"
                               Foreground="{DynamicResource RedChannelBrush}"
                               FontSize="11.5" TextWrapping="Wrap"
                               Visibility="Collapsed" Margin="0,0,0,4"/>
                    <TextBlock x:Name="MessageText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11.5" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="6" Orientation="Horizontal">
                    <Button x:Name="ApplyBuiltInBtn" Content="应用到本卷"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed"
                            Click="ApplyBuiltInBtn_Click"/>
                    <Button x:Name="SaveOnlyBtn" Content="保存到电脑"
                            Style="{StaticResource ToolbarNeutralButtonStyle}"
                            Margin="0,0,8,0"
                            Click="SaveOnlyBtn_Click"/>
                    <Button x:Name="SaveAndApplyBtn" Content="保存并应用到本卷"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SaveAndApplyBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
