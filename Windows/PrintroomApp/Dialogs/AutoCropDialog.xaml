<Window x:Class="PrintroomApp.Dialogs.AutoCropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动裁剪"
        Width="390"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppSansFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="自动裁剪" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="画幅比例" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <ComboBox x:Name="RatioCombo" Grid.Column="1"
                      Style="{StaticResource ThemedComboBoxStyle}"
                      SelectionChanged="RatioCombo_SelectionChanged"/>
        </Grid>

        <Grid x:Name="CustomRatioPanel" Margin="78,0,0,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CustomWidthBox" Grid.Column="0"
                     Text="3" Height="26" VerticalContentAlignment="Center"
                     Style="{StaticResource ThemedTextBoxStyle}"
                     TextChanged="RatioInput_TextChanged"/>
            <TextBlock Grid.Column="1" Text=":" Margin="8,0" VerticalAlignment="Center"/>
            <TextBox x:Name="CustomHeightBox" Grid.Column="2"
                     Text="2" Height="26" VerticalContentAlignment="Center"
                     Style="{StaticResource ThemedTextBoxStyle}"
                     TextChanged="RatioInput_TextChanged"/>
        </Grid>

        <CheckBox x:Name="SwapRatioCheck" Content="交换宽高"
                  Margin="78,0,0,10"
                  Checked="SwapRatioCheck_Changed" Unchecked="SwapRatioCheck_Changed"/>

        <TextBlock x:Name="RatioErrorText"
                   Text="请输入有效正数，比例范围为 1:10～10:1。"
                   Foreground="{DynamicResource RedChannelBrush}"
                   FontSize="11.5" TextWrapping="Wrap"
                   Margin="78,0,0,10"
                   Visibility="Collapsed"/>

        <CheckBox x:Name="PreserveExistingCheck" Content="保留已裁剪"
                  Margin="78,0,0,14"/>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="每边内收" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <ComboBox x:Name="InwardCombo" Grid.Column="1"
                      Style="{StaticResource ThemedComboBoxStyle}"/>
        </Grid>

        <StackPanel x:Name="ProgressPanel" Margin="0,0,0,16" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Height="6"
                         Background="{DynamicResource ControlBrush}"
                         Foreground="{DynamicResource AccentBrush}"
                         BorderThickness="0" Margin="0,0,0,8"/>
            <TextBlock x:Name="ProgressText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11.5" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="CancelBtn" Content="取消"
                    Style="{StaticResource ToolbarNeutralButtonStyle}"
                    MinWidth="74"
                    Click="CancelBtn_Click"/>
            <Button x:Name="StartBtn" Content="开始"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="74" Margin="8,0,0,0" IsDefault="True"
                    Click="StartBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
