<Window x:Class="PrintroomApp.Dialogs.RollTimingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="色罩分析"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <StackPanel Margin="22">
        <TextBlock x:Name="TitleText"
                   Text="色罩分析"
                   FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

        <!-- Missing Film Base Info -->
        <TextBlock x:Name="MissingBaseHintText"
                   Text="需要先在预览图中框选片基区域，才能进行整卷色罩分析。"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="12" TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Visibility="Collapsed"/>

        <!-- Confirmation Options -->
        <CheckBox x:Name="AutoExposureCheckBox"
                  Content="自动曝光"
                  IsChecked="True"
                  Margin="0,0,0,16"
                  Visibility="Collapsed"/>

        <!-- Progress -->
        <StackPanel x:Name="ProgressPanel" Margin="0,0,0,16" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Height="6"
                         Background="{DynamicResource ControlBrush}"
                         Foreground="{DynamicResource AccentBrush}"
                         BorderThickness="0" Margin="0,0,0,8"/>
            <TextBlock x:Name="ProgressText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Result: Success -->
        <CheckBox x:Name="PreserveEditedCheckBox"
                  Content="保留已调色"
                  IsChecked="False"
                  Margin="0,0,0,16"
                  Visibility="Collapsed"/>

        <!-- Result: Error -->
        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource RedChannelBrush}"
                   FontSize="12" TextWrapping="Wrap"
                   Margin="0,0,0,16"
                   Visibility="Collapsed"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="取消"
                    Style="{StaticResource ToolbarNeutralButtonStyle}"
                    MinWidth="74" IsCancel="True"
                    Click="CancelBtn_Click"/>
            <Button x:Name="PrimaryBtn" Content="开始分析"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="84" Margin="8,0,0,0" IsDefault="True"
                    Click="PrimaryBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
