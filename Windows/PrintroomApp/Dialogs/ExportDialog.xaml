<Window x:Class="PrintroomApp.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppSansFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <StackPanel Margin="22">
        <TextBlock x:Name="HeaderTitleText" Text="导出" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Destination -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="目的地"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,12,10"/>
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DestinationText" Grid.Column="0"
                           Text="请选择文件夹"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,8,0"/>
                <Button x:Name="ChooseDestBtn" Grid.Column="1" Content="选择…"
                        Style="{StaticResource ToolbarNeutralButtonStyle}"
                        Click="ChooseDestBtn_Click"/>
            </Grid>

            <!-- Prefix -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="文件名前缀"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,12,10"/>
            <TextBox x:Name="PrefixBox" Grid.Row="1" Grid.Column="1"
                     Style="{StaticResource ThemedTextBoxStyle}"
                     InputMethod.IsInputMethodEnabled="True"
                     Height="28" VerticalContentAlignment="Center"
                     Margin="0,0,0,10"
                     TextChanged="PrefixBox_TextChanged"/>

            <!-- Format -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="格式"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,12,10"/>
            <ComboBox x:Name="FormatCombo" Grid.Row="2" Grid.Column="1"
                      Style="{StaticResource ThemedComboBoxStyle}"
                      Margin="0,0,0,10"
                      SelectionChanged="FormatCombo_SelectionChanged"/>

            <!-- Color Space -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="色彩空间"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,12,10"/>
            <ComboBox x:Name="ProfileCombo" Grid.Row="3" Grid.Column="1"
                      Style="{StaticResource ThemedComboBoxStyle}"
                      Margin="0,0,0,10"
                      SelectionChanged="OptionControl_Changed"/>

            <!-- ZIP Compression (TIFF only) -->
            <CheckBox x:Name="CompressionCheckBox" Grid.Row="4" Grid.Column="1"
                      Content="ZIP 压缩"
                      Margin="0,2,0,10"
                      Click="OptionControl_Changed"/>

            <!-- Apply Crop & Overwrite -->
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0">
                <CheckBox x:Name="ApplyCropCheckBox" Content="应用裁剪" Margin="0,0,18,0" Click="OptionControl_Changed"/>
                <CheckBox x:Name="OverwriteCheckBox" Content="覆盖重名" Click="OptionControl_Changed"/>
            </StackPanel>
        </Grid>

        <!-- Progress / Result Row -->
        <Grid x:Name="StatusRow" Margin="0,18,0,0" Height="24" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       FontSize="11.5"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0"/>
            <ProgressBar x:Name="ExportProgressBar" Grid.Column="1"
                         Width="140" Height="7" Minimum="0" Maximum="1"
                         Background="{DynamicResource ControlBrush}"
                         Foreground="{DynamicResource AccentBrush}"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
            <TextBlock x:Name="PercentText" Grid.Column="2"
                       Width="38" TextAlignment="Right"
                       FontFamily="Consolas" FontSize="11.5"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelCloseBtn" Content="取消"
                    Style="{StaticResource ToolbarNeutralButtonStyle}"
                    MinWidth="76"
                    Click="CancelCloseBtn_Click"/>
            <Button x:Name="ExportBtn" Content="导出"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="76" Margin="8,0,0,0" IsDefault="True"
                    Click="ExportBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
