<UserControl x:Class="PrintroomApp.Controls.AdjustmentRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26">
    <Grid Margin="0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="58"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LabelText" Grid.Column="0"
                   FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center"/>
        <Slider x:Name="ValueSlider" Grid.Column="1"
                Margin="4,0,8,0"
                IsMoveToPointEnabled="True"
                VerticalAlignment="Center"
                Focusable="False"/>
        <TextBox x:Name="ValueBox" Grid.Column="2"
                 FontFamily="Consolas" FontSize="11"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 Style="{StaticResource ThemedTextBoxStyle}"
                 Height="22"
                 KeyDown="ValueBox_KeyDown"
                 LostKeyboardFocus="ValueBox_LostKeyboardFocus"/>
    </Grid>
</UserControl>
