<UserControl x:Class="PrintroomApp.Controls.AdjustmentRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PrintroomApp.Controls"
             Height="26">
    <Grid Margin="0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="54"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LabelText" Grid.Column="0"
                   FontSize="11.5"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center"/>
        <controls:ChannelSliderControl x:Name="ValueSlider" Grid.Column="1"
                                       Margin="4,0,8,0"
                                       VerticalAlignment="Center"/>
        <TextBox x:Name="ValueBox" Grid.Column="2"
                 FontFamily="{StaticResource AppMonoFont}" FontSize="11.5"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 Style="{StaticResource ThemedTextBoxStyle}"
                 Height="22"
                 KeyDown="ValueBox_KeyDown"
                 LostKeyboardFocus="ValueBox_LostKeyboardFocus"/>
    </Grid>
</UserControl>
