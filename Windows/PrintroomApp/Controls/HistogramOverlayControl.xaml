<UserControl x:Class="PrintroomApp.Controls.HistogramOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootBorder"
            Background="{DynamicResource HistogramBrush}"
            BorderBrush="{DynamicResource SubtleSeparatorBrush}"
            BorderThickness="0.75"
            CornerRadius="10"
            Padding="9,8"
            Cursor="Arrow">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.24" BlurRadius="12" ShadowDepth="3" Direction="270"/>
        </Border.Effect>
        <StackPanel x:Name="ContentStack">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="StagePickerPanel" Grid.Column="0" Margin="0,0,8,0"
                        Background="{DynamicResource SecondaryPanelBrush}"
                        CornerRadius="6" Padding="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DensityBtn" Grid.Column="0" Content="Density" Click="DensityBtn_Click"
                                Style="{StaticResource PillSegmentButtonStyle}" FontSize="10.5" Height="20"/>
                        <Button x:Name="FinalBtn" Grid.Column="1" Content="Final" Click="FinalBtn_Click"
                                Style="{StaticResource PillSegmentButtonStyle}" FontSize="10.5" Height="20"/>
                    </Grid>
                </Border>
                <Button x:Name="CollapseBtn" Grid.Column="1" Click="CollapseBtn_Click"
                        Style="{StaticResource FlatIconButtonStyle}" Height="22" Padding="5,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CollapsedTitleText" Text="直方图" FontSize="11" Margin="0,0,5,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        <Path x:Name="CollapseIconPath"
                              Data="{StaticResource GeoChevronDown}"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel x:Name="ChartPanel" Margin="0,6,0,0" Width="198">
                <Border BorderBrush="{DynamicResource SubtleSeparatorBrush}" BorderThickness="0.75" CornerRadius="2" Height="74" ClipToBounds="True">
                    <Canvas x:Name="PlotCanvas" Width="198" Height="74" IsHitTestVisible="False"/>
                </Border>
                <Canvas x:Name="AxisCanvas" Width="198" Height="14" Margin="0,3,0,0" IsHitTestVisible="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
