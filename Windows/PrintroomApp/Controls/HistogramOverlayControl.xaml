<UserControl x:Class="PrintroomApp.Controls.HistogramOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootBorder"
            Background="{DynamicResource HistogramBrush}"
            BorderBrush="{DynamicResource SubtleSeparatorBrush}"
            BorderThickness="0.75"
            CornerRadius="10"
            Padding="10"
            Cursor="Arrow">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.22" BlurRadius="10" ShadowDepth="3" Direction="270"/>
        </Border.Effect>
        <StackPanel x:Name="ContentStack">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="StagePickerPanel" Grid.Column="0" Margin="0,0,8,0"
                        Background="{DynamicResource SecondaryPanelBrush}"
                        CornerRadius="5" Padding="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DensityBtn" Grid.Column="0" Content="Density" Click="DensityBtn_Click"
                                FontSize="10.5" Height="20" Padding="6,0" BorderThickness="0"/>
                        <Button x:Name="FinalBtn" Grid.Column="1" Content="Final" Click="FinalBtn_Click"
                                FontSize="10.5" Height="20" Padding="6,0" BorderThickness="0"/>
                    </Grid>
                </Border>
                <Button x:Name="CollapseBtn" Grid.Column="1" Click="CollapseBtn_Click"
                        Style="{StaticResource FlatIconButtonStyle}" Height="22" Padding="6,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CollapsedTitleText" Text="直方图 " FontSize="11" Visibility="Collapsed"/>
                        <TextBlock x:Name="CollapseGlyph" Text="▾" FontSize="11"/>
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel x:Name="ChartPanel" Margin="0,6,0,0" Width="228">
                <Border BorderBrush="{DynamicResource SubtleSeparatorBrush}" BorderThickness="0.75" Height="78" ClipToBounds="True">
                    <Canvas x:Name="PlotCanvas" Width="228" Height="78" IsHitTestVisible="False"/>
                </Border>
                <Canvas x:Name="AxisCanvas" Width="228" Height="14" Margin="0,3,0,0" IsHitTestVisible="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
