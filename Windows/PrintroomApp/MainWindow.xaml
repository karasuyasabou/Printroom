<Window x:Class="PrintroomApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PrintroomApp.Controls"
        Title="Printroom"
        Width="1360" Height="860"
        MinWidth="1060" MinHeight="720"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="Assets/Printroom.ico"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu Bar -->
            <RowDefinition Height="46"/>   <!-- Unified Top Toolbar -->
            <RowDefinition Height="1"/>    <!-- Divider -->
            <RowDefinition Height="*"/>    <!-- Main Content or Import Screen -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{DynamicResource SecondaryPanelBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" Padding="4,2">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开底片文件夹…" InputGestureText="Ctrl+O" Click="OpenRoll_Click"/>
                <MenuItem x:Name="RecentRollsMenu" Header="最近打开的胶卷"/>
                <Separator/>
                <MenuItem x:Name="SaveProjectMenuItem" Header="保存胶卷设置" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                <MenuItem x:Name="SaveBackupMenuItem" Header="另存设置副本…" Click="SaveBackup_Click"/>
                <MenuItem x:Name="RestoreBackupMenuItem" Header="恢复本卷设置副本…" Click="RestoreBackup_Click"/>
                <Separator/>
                <MenuItem x:Name="ExportCurrentMenuItem" Header="导出当前照片…" InputGestureText="Ctrl+Shift+E" Click="ExportCurrent_Click"/>
                <MenuItem x:Name="ExportSelectedMenuItem" Header="导出选中照片…" Click="ExportSelected_Click"/>
                <MenuItem x:Name="ExportAllMenuItem" Header="导出整卷…" Click="ExportAll_Click"/>
                <Separator/>
                <MenuItem Header="管理缓存…" Click="OpenCacheManager_Click"/>
                <Separator/>
                <MenuItem Header="回到主页" Click="ReturnHome_Click" x:Name="ReturnHomeMenuItem"/>
                <MenuItem Header="退出" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem x:Name="UndoMenuItem" Header="撤销" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem x:Name="RedoMenuItem" Header="重做" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem x:Name="CopyMenuItem" Header="复制调色" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                <MenuItem x:Name="PasteMenuItem" Header="粘贴调色" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                <MenuItem x:Name="SelectAllMenuItem" Header="全选照片" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                <MenuItem x:Name="SyncMenuItem" Header="同步…" Click="SyncButton_Click"/>
                <Separator/>
                <MenuItem x:Name="ResetAdjMenuItem" Header="重置调色" Click="ResetAdjustments_Click"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="键盘快捷键…" InputGestureText="F1" Click="OpenShortcuts_Click"/>
            </MenuItem>
        </Menu>

        <!-- Unified Top Toolbar -->
        <Grid Grid.Row="1" Background="{DynamicResource SecondaryPanelBrush}" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Branding Left -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="Assets/Printroom.ico" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="PRINTROOM" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="VersionLabel" Text="v1.0.4" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Light/Dark Appearance Capsule -->
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0.75" CornerRadius="14" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LightThemeBtn" Content="☀" Width="28" Height="22" FontSize="12" ToolTip="浅色外观" Click="LightThemeBtn_Click" BorderThickness="0"/>
                        <Button x:Name="DarkThemeBtn" Content="☾" Width="28" Height="22" FontSize="12" ToolTip="深色外观" Click="DarkThemeBtn_Click" BorderThickness="0" Margin="2,0,0,0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="UpdateAvailableBtn" Content="⬇ 新版本" Visibility="Collapsed" Click="UpdateAvailableBtn_Click"
                        Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" FontSize="12" Margin="10,0,0,0" Cursor="Hand"/>
            </StackPanel>

            <!-- Actions Right -->
            <StackPanel x:Name="ToolbarActionsPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button x:Name="HomeBtn" Content="⌂ 回到主页" Style="{StaticResource ToolbarNeutralButtonStyle}" Click="ReturnHome_Click"/>
                <Rectangle Width="1" Height="20" Fill="{DynamicResource SeparatorBrush}" Margin="10,0"/>
                <Button x:Name="SprocketBtn" Content="🎞 齿孔置白" Style="{StaticResource ToolbarNeutralButtonStyle}" Click="SprocketBtn_Click" Margin="0,0,8,0" ToolTip="设置整卷齿孔置白"/>
                <Button x:Name="AutoCropBtn" Content="⊡ 自动裁剪" Style="{StaticResource ToolbarNeutralButtonStyle}" Click="AutoCropBtn_Click" Margin="0,0,8,0" ToolTip="设置并分析整卷自动裁剪"/>
                <Button x:Name="RollTimingBtn" Content="✦ 色罩分析" Style="{StaticResource ToolbarNeutralButtonStyle}" Click="RollTimingBtn_Click" Margin="0,0,8,0" ToolTip="色罩分析"/>
                <Button x:Name="ResetBtn" Content="↺ 重置调色" Style="{StaticResource ToolbarNeutralButtonStyle}" Click="ResetAdjustments_Click" Margin="0,0,8,0" ToolTip="重置当前照片的 Timing、Contrast 与 Cineon Log LUT · 可撤销"/>
                <Button x:Name="ExportToolbarBtn" Content="↥ 导出 ▾" Style="{StaticResource ToolbarNeutralButtonStyle}" Click="ExportToolbarBtn_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ExportToolbarMenu">
                            <MenuItem x:Name="ExportToolbarSelectedItem" Header="导出选中 0 张…" Click="ExportSelected_Click"/>
                            <MenuItem x:Name="ExportToolbarAllItem" Header="导出整卷…" Click="ExportAll_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SeparatorBrush}"/>

        <!-- Main Editor Grid -->
        <Grid x:Name="EditorContainer" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="154"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="306"/>
                </Grid.ColumnDefinitions>

                <!-- Preview + Sub-toolbar -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sub-Toolbar Row -->
                    <Grid Grid.Row="0" Background="{DynamicResource PanelBrush}">
                        <!-- Normal Preview Sub-toolbar -->
                        <Grid x:Name="PreviewSubToolbar" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ActiveFilenameText" Grid.Column="0" Text="预览" FontFamily="Consolas" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BeginCropBtn" Content="✂ 裁剪" Style="{StaticResource FlatIconButtonStyle}" Click="BeginCropBtn_Click" ToolTip="裁剪与精细角度 · R" Margin="0,0,4,0"/>
                                <Button x:Name="RotLeftBtn" Content="↶" Style="{StaticResource FlatIconButtonStyle}" Width="28" Click="RotLeft_Click" ToolTip="向左旋转 90° ( [ )"/>
                                <Button x:Name="RotRightBtn" Content="↷" Style="{StaticResource FlatIconButtonStyle}" Width="28" Click="RotRight_Click" ToolTip="向右旋转 90° ( ] )"/>
                                <Button x:Name="FlipHBtn" Content="⇄" Style="{StaticResource FlatIconButtonStyle}" Width="28" Click="FlipH_Click" ToolTip="水平翻转 (Ctrl+F)"/>
                                <Button x:Name="FlipVBtn" Content="⇅" Style="{StaticResource FlatIconButtonStyle}" Width="28" Click="FlipV_Click" ToolTip="垂直翻转"/>
                                <Rectangle Width="1" Height="14" Fill="{DynamicResource SeparatorBrush}" Margin="6,0"/>
                                <CheckBox x:Name="CropPreviewCheckBox" Content="裁剪预览" FontSize="12" Margin="4,0,8,0" VerticalAlignment="Center"
                                          Click="CropPreviewCheckBox_Click" ToolTip="仅切换主画面的裁剪效果，直方图仍统计裁剪后的画面"/>
                                <Button x:Name="StageMenuBtn" Content="管线预览 原图 ▾" Style="{StaticResource FlatIconButtonStyle}" Click="StageMenuBtn_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="StageContextMenu">
                                            <MenuItem x:Name="StageL2Item" Header="线性" IsCheckable="True" Click="StageL2_Click"/>
                                            <MenuItem x:Name="StageD3Item" Header="密度" IsCheckable="True" Click="StageD3_Click"/>
                                            <MenuItem x:Name="StageFinalItem" Header="输出" IsCheckable="True" Click="StageFinal_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Interactive Crop Controls Sub-toolbar -->
                        <Grid x:Name="CropControlsBar" Visibility="Collapsed" Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="长宽比：" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <Button x:Name="CropAspectBtn" Content="原始图像 ▾" Style="{StaticResource FlatIconButtonStyle}" FontSize="11" Click="CropAspectBtn_Click" MinWidth="66">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="CropAspectMenu">
                                            <MenuItem Header="原始图像" Click="CropAspectOriginal_Click"/>
                                            <Separator/>
                                            <MenuItem Header="3:2" Click="CropAspectPreset_Click" Tag="3:2"/>
                                            <MenuItem Header="4:3" Click="CropAspectPreset_Click" Tag="4:3"/>
                                            <MenuItem Header="1:1" Click="CropAspectPreset_Click" Tag="1:1"/>
                                            <MenuItem Header="7:6" Click="CropAspectPreset_Click" Tag="7:6"/>
                                            <Separator/>
                                            <MenuItem Header="输入自定值…" Click="CropAspectCustom_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="CropLockBtn" Content="🔒" Style="{StaticResource FlatIconButtonStyle}" Width="26" Click="CropLockBtn_Click" ToolTip="解锁/锁定长宽比" Margin="2,0"/>
                                <Button x:Name="CropSwapBtn" Content="交换宽高" Style="{StaticResource ToolbarNeutralButtonStyle}" Height="24" FontSize="11" Padding="8,2" Click="CropSwapBtn_Click"/>
                                <Rectangle Width="1" Height="18" Fill="{DynamicResource SeparatorBrush}" Margin="8,0"/>
                                <TextBlock Text="角度" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="CropAngleSlider" Width="96" Minimum="-10" Maximum="10" SmallChange="0.01" LargeChange="0.5"
                                        VerticalAlignment="Center" IsMoveToPointEnabled="True" Focusable="False"
                                        ToolTip="−10° 至 +10° · 双击归零 · Q/E 微调"
                                        PreviewMouseLeftButtonDown="CropAngleSlider_PreviewMouseLeftButtonDown"
                                        ValueChanged="CropAngleSlider_ValueChanged"/>
                                <TextBlock x:Name="CropAngleText" Text="0.00°" FontFamily="Consolas" FontSize="11" Width="46" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Rectangle Width="1" Height="18" Fill="{DynamicResource SeparatorBrush}" Margin="8,0"/>
                                <Button x:Name="CropResetBtn" Content="重置" Style="{StaticResource ToolbarNeutralButtonStyle}" Height="24" FontSize="11" Padding="8,2" Click="CropResetBtn_Click" ToolTip="重置裁剪范围与角度"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CropReviewFilterBtn" Content="待检查 0 ▾" Visibility="Collapsed" Style="{StaticResource FlatIconButtonStyle}" FontSize="11" Margin="0,0,6,0" Click="CropReviewFilterBtn_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="ReviewOnlyPendingMenuItem" Header="仅看待检查" IsCheckable="True" Click="ReviewOnlyPendingMenuItem_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Content="取消" Style="{StaticResource ToolbarNeutralButtonStyle}" Height="24" FontSize="11" Padding="10,2" Click="CancelCrop_Click" ToolTip="取消本次裁剪 · Esc" Margin="0,0,6,0"/>
                                <Button x:Name="CropPrimaryBtn" Content="完成" Style="{StaticResource AccentButtonStyle}" Height="24" FontSize="11" Padding="12,2" Click="PrimaryCrop_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Canvas Area -->
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <controls:PreviewCanvasControl x:Name="CanvasControl"/>

                        <!-- Welcome / Empty State Overlay -->
                        <Grid x:Name="EmptyStateOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Width="520">
                                <TextBlock Text="⊡" FontSize="36" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <Button Content="打开底片文件夹" Style="{StaticResource AccentButtonStyle}" Click="OpenRoll_Click" Margin="0,0,10,0"/>
                                    <Button Content="管理缓存" Style="{StaticResource ToolbarNeutralButtonStyle}" Click="OpenCacheManager_Click"/>
                                </StackPanel>

                                <StackPanel x:Name="RecentRollsSection" Visibility="Collapsed">
                                    <TextBlock Text="最近打开的胶卷" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,0,0,8"/>
                                    <ScrollViewer MaxHeight="264" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="RecentRollsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" CornerRadius="6" Padding="8,4" Margin="0,1" MouseEnter="RecentRow_MouseEnter" MouseLeave="RecentRow_MouseLeave">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="重命名…" Tag="{Binding}" Click="RecentRename_Click" IsEnabled="{Binding IsAvailable}"/>
                                                                <MenuItem Header="从最近记录中移除" Tag="{Binding}" Click="RecentRemove_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Click="RecentOpen_Click" Tag="{Binding}" HorizontalContentAlignment="Stretch"
                                                                    Background="Transparent" BorderThickness="0" Padding="2" Cursor="Hand">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="28"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="📁" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{Binding DateLabel}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="1" x:Name="RemoveRecentBtn" Content="✕" Tag="{Binding}" Click="RecentRemove_Click"
                                                                    Style="{StaticResource FlatIconButtonStyle}" Width="24" Height="24" FontSize="10" ToolTip="从最近记录中移除"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <Grid x:Name="RemovedRecentBanner" Visibility="Collapsed" Margin="6,8,6,0" Height="24">
                                    <TextBlock x:Name="RemovedRecentText" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <Button Content="撤销" HorizontalAlignment="Right" Style="{StaticResource FlatIconButtonStyle}" FontSize="11" Click="UndoRemoveRecent_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Film Base Selection Pill -->
                        <Border x:Name="SamplingHintPill" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                Background="{DynamicResource HistogramBrush}" BorderBrush="{DynamicResource SubtleSeparatorBrush}" BorderThickness="0.75"
                                CornerRadius="16" Padding="14,7" IsHitTestVisible="False">
                            <TextBlock Text="⌖  拖动框选未曝光片基" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>

                        <!-- Histogram Floating Panel -->
                        <controls:HistogramOverlayControl x:Name="HistogramControl" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Visibility="Collapsed"/>

                        <!-- Preview Loading Hint -->
                        <Border x:Name="PreviewLoadingHint" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12"
                                Background="#60000000" CornerRadius="6" Padding="8,5" IsHitTestVisible="False">
                            <TextBlock Text="正在加载预览…" FontSize="11" Foreground="#CCFFFFFF"/>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource SeparatorBrush}"/>

                <!-- Right Inspector (306px) -->
                <ScrollViewer Grid.Column="2" Background="{DynamicResource PanelBrush}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- 01 Matrix Correction -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="01" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="矩阵矫正 · 整卷" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="ManageMatrixBtn" Content="管理…" HorizontalAlignment="Right" Style="{StaticResource FlatIconButtonStyle}" FontSize="11" Click="ManageMatrixBtn_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="管理CMOS 矩阵…" Click="ManageCMOSMatrix_Click"/>
                                        <MenuItem Header="管理密度矩阵…" Click="ManageDensityMatrix_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CMOS 矩阵" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CMOSMatrixCombo" Grid.Column="1" FontSize="11" SelectionChanged="CMOSMatrixCombo_SelectionChanged" DisplayMemberPath="DisplayTitle"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="密度矩阵" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="DensityMatrixCombo" Grid.Column="1" FontSize="11" SelectionChanged="DensityMatrixCombo_SelectionChanged" DisplayMemberPath="DisplayTitle"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource SubtleSeparatorBrush}" Margin="0,14"/>

                        <!-- 02 Film Base Alignment -->
                        <Grid Margin="0,4,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="02" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="FILM BASE 对齐 · 整卷" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="FilmBaseSampleBtn" Content="⌖ 框选片基" HorizontalAlignment="Right" Style="{StaticResource ToolbarNeutralButtonStyle}" Height="26" FontSize="11" Padding="8,2" Click="FilmBaseSampleBtn_Click"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource SubtleSeparatorBrush}" Margin="0,14"/>

                        <!-- 03 Color Timing -->
                        <StackPanel x:Name="ColorTimingSection">
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="03" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Color Timing" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SecondaryPanelBrush}" CornerRadius="5" Padding="2" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SimpleModeBtn" Content="简易" Width="44" Height="20" FontSize="11" BorderThickness="0" Click="SimpleModeBtn_Click"/>
                                            <Button x:Name="RgbModeBtn" Content="RGB" Width="44" Height="20" FontSize="11" BorderThickness="0" Click="RgbModeBtn_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="NeutralPipetteBtn" Content="🖌" Width="26" Height="22" Style="{StaticResource FlatIconButtonStyle}" ToolTip="Final 中性点吸管 (I) · 保持亮度" Click="NeutralPipetteBtn_Click"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="SimpleTimingPanel">
                                <controls:AdjustmentRowControl x:Name="ExposureRow" Label="曝光" Title="曝光 · 暗 ↔ 亮 · W / S" Minimum="-1024" Maximum="1024" Step="1" FractionDigits="0" QuantizesValue="False" ResetValue="0" TrackColorBrush="{DynamicResource PrimaryTextBrush}"/>
                                <controls:AdjustmentRowControl x:Name="TemperatureRow" Label="色温" Title="色温 · 冷 ↔ 暖 · Q / E" Minimum="-512" Maximum="512" Step="1" FractionDigits="0" QuantizesValue="False" ResetValue="0" TrackColorBrush="{DynamicResource TemperatureBrush}"/>
                                <controls:AdjustmentRowControl x:Name="TintRow" Label="色调" Title="色调 · 绿 ↔ 洋红 · A / D" Minimum="-341.333333" Maximum="341.333333" Step="1" FractionDigits="0" QuantizesValue="False" ResetValue="0" TrackColorBrush="{DynamicResource TintBrush}"/>
                                <Border Height="26"/>
                            </StackPanel>

                            <StackPanel x:Name="RgbTimingPanel" Visibility="Collapsed">
                                <controls:AdjustmentRowControl x:Name="TimingMasterRow" Label="Master" Title="Color Timing Master" Minimum="-512" Maximum="512" Step="1" FractionDigits="0" QuantizesValue="True" ResetValue="0" TrackColorBrush="{DynamicResource PrimaryTextBrush}"/>
                                <controls:AdjustmentRowControl x:Name="TimingRedRow" Label="Red" Title="Color Timing Red" Minimum="-512" Maximum="512" Step="1" FractionDigits="0" QuantizesValue="True" ResetValue="0" TrackColorBrush="{DynamicResource RedChannelBrush}"/>
                                <controls:AdjustmentRowControl x:Name="TimingGreenRow" Label="Green" Title="Color Timing Green" Minimum="-512" Maximum="512" Step="1" FractionDigits="0" QuantizesValue="True" ResetValue="0" TrackColorBrush="{DynamicResource GreenChannelBrush}"/>
                                <controls:AdjustmentRowControl x:Name="TimingBlueRow" Label="Blue" Title="Color Timing Blue" Minimum="-512" Maximum="512" Step="1" FractionDigits="0" QuantizesValue="True" ResetValue="0" TrackColorBrush="{DynamicResource BlueChannelBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource SubtleSeparatorBrush}" Margin="0,14"/>

                        <!-- 04 RGB Contrast -->
                        <StackPanel x:Name="ContrastSection">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="04" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="RGB Contrast" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <controls:AdjustmentRowControl x:Name="ContrastMasterRow" Label="Master" Title="Contrast Master" Minimum="0.25" Maximum="2.0" Step="0.01" FractionDigits="2" QuantizesValue="True" ResetValue="1.0" TrackColorBrush="{DynamicResource PrimaryTextBrush}"/>
                            <controls:AdjustmentRowControl x:Name="ContrastRedRow" Label="Red" Title="Contrast Red" Minimum="0.25" Maximum="2.0" Step="0.01" FractionDigits="2" QuantizesValue="True" ResetValue="1.0" TrackColorBrush="{DynamicResource RedChannelBrush}"/>
                            <controls:AdjustmentRowControl x:Name="ContrastGreenRow" Label="Green" Title="Contrast Green" Minimum="0.25" Maximum="2.0" Step="0.01" FractionDigits="2" QuantizesValue="True" ResetValue="1.0" TrackColorBrush="{DynamicResource GreenChannelBrush}"/>
                            <controls:AdjustmentRowControl x:Name="ContrastBlueRow" Label="Blue" Title="Contrast Blue" Minimum="0.25" Maximum="2.0" Step="0.01" FractionDigits="2" QuantizesValue="True" ResetValue="1.0" TrackColorBrush="{DynamicResource BlueChannelBrush}"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource SubtleSeparatorBrush}" Margin="0,14"/>

                        <!-- 05 Cineon Log LUT -->
                        <Grid x:Name="LutSection">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="05" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cineon Log LUT" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ComboBox x:Name="LutCombo" Grid.Column="1" FontSize="11" SelectionChanged="LutCombo_SelectionChanged">
                                <ComboBoxItem Content="Kodak 2383" Tag="kodak2383"/>
                                <ComboBoxItem Content="Fujifilm 3513DI" Tag="fujifilm3513DI"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SeparatorBrush}"/>

            <!-- Bottom Filmstrip -->
            <Grid Grid.Row="2" Background="{DynamicResource SecondaryPanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filmstrip Header -->
                <Grid Grid.Row="0" Margin="14,8,14,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="RollTitlePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                            <TextBlock x:Name="RollTitleText" FontSize="12" FontWeight="SemiBold" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Content="✎" Style="{StaticResource FlatIconButtonStyle}" ToolTip="命名胶卷" Click="RenameCurrentRoll_Click" Margin="4,0,0,0"/>
                            <Button x:Name="RevealFolderBtn" Content="📁" Style="{StaticResource FlatIconButtonStyle}" ToolTip="在资源管理器中打开底片文件夹" Click="RevealFolder_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="FilmstripCountText" Text="0 张 · 已选 0 张" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="CopiedBadgeText" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                        <Button x:Name="SyncBtn" Content="同步…" Style="{StaticResource ToolbarNeutralButtonStyle}" Height="24" FontSize="11" Padding="10,2" Click="SyncButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Filmstrip Horizontal ScrollViewer -->
                <ScrollViewer x:Name="FilmstripScroll" Grid.Row="1" Margin="14,0,14,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="FilmstripScroll_PreviewMouseWheel">
                    <ItemsControl x:Name="FilmstripItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Thumbnail_Click" Tag="{Binding}" Padding="0" Background="Transparent" BorderThickness="0" Margin="0,0,8,0"
                                        PreviewMouseRightButtonDown="Thumbnail_PreviewMouseRightButtonDown">
                                    <Button.ContextMenu>
                                        <ContextMenu Opened="ThumbnailContextMenu_Opened">
                                            <MenuItem x:Name="CtxRelocate" Header="重新定位此照片…" Tag="{Binding}" Click="RelocateFrame_Click"/>
                                            <MenuItem x:Name="CtxCopy" Header="复制调色（Ctrl+C）" Click="Copy_Click"/>
                                            <MenuItem x:Name="CtxPaste" Header="粘贴调色（Ctrl+V）" Click="Paste_Click"/>
                                            <Separator x:Name="CtxSep"/>
                                            <MenuItem x:Name="CtxFlipH" Header="水平翻转" Tag="flipHorizontal" Click="BatchOrientation_Click"/>
                                            <MenuItem x:Name="CtxFlipV" Header="垂直翻转" Tag="flipVertical" Click="BatchOrientation_Click"/>
                                            <MenuItem x:Name="CtxRotCW" Header="顺时针旋转" Tag="rotateClockwise" Click="BatchOrientation_Click"/>
                                            <MenuItem x:Name="CtxRotCCW" Header="逆时针旋转" Tag="rotateCounterclockwise" Click="BatchOrientation_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border CornerRadius="5" Padding="4" Opacity="{Binding TileOpacity}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid Width="124" Height="78" ClipToBounds="True" Background="#14000000">
                                                <TextBlock Text="🖼" FontSize="20" Foreground="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasBitmap}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                    <Setter Property="Text" Value="⚠"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Image Source="{Binding ThumbnailBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#A6000000" Padding="4,1" CornerRadius="2">
                                                    <TextBlock Text="{Binding DisplayNumber}" FontFamily="Consolas" FontSize="9" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Filename}" FontFamily="Consolas" FontSize="9" Width="124" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Full-Window Roll Loading Screen -->
        <Grid x:Name="ImportOverlay" Grid.Row="3" Background="{DynamicResource WindowBrush}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <StackPanel x:Name="ImportProgressStack" HorizontalAlignment="Center">
                    <TextBlock Text="正在加载…" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <ProgressBar x:Name="ImportProgressBar" Width="280" Height="8" Minimum="0" Maximum="1" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ImportCountText" Text="0 / 0" FontFamily="Consolas" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Button Content="取消加载" Style="{StaticResource ToolbarNeutralButtonStyle}" Click="CancelImport_Click" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ImportFailureStack" Visibility="Collapsed" HorizontalAlignment="Center">
                    <TextBlock Text="加载未完成" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <ScrollViewer MaxHeight="180" Margin="0,0,0,14">
                        <TextBox x:Name="ImportFailureText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="返回主页" Style="{StaticResource ToolbarNeutralButtonStyle}" Click="CancelImport_Click" Margin="0,0,10,0"/>
                        <Button Content="重试" Style="{StaticResource AccentButtonStyle}" Click="RetryImport_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Popups (Sprocket Whitening & Selective Sync) -->
        <Popup x:Name="SprocketPopup" PlacementTarget="{Binding ElementName=SprocketBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Width="290">
                <StackPanel>
                    <CheckBox x:Name="SprocketEnableCheck" Content="齿孔置白" FontSize="12" Click="SprocketEnableCheck_Click" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="识别阈值" FontSize="12"/>
                        <TextBlock x:Name="SprocketThresholdLabel" Text="片基 +5%" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                    <Slider x:Name="SprocketThresholdSlider" Minimum="5" Maximum="200" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                            PreviewMouseLeftButtonDown="SprocketSlider_MouseDown" PreviewMouseLeftButtonUp="SprocketSlider_MouseUp" ValueChanged="SprocketSlider_ValueChanged"/>
                    <TextBlock x:Name="SprocketHintText" Text="请先完成片基校准，并为照片设置裁剪。" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="SyncPopup" PlacementTarget="{Binding ElementName=SyncBtn}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Width="310">
                <StackPanel>
                    <TextBlock Text="同步" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SyncSourceLabel" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="SyncTimingCheck" Content="Color Timing" Margin="0,0,0,8" Click="SyncOptionCheck_Click"/>
                    <CheckBox x:Name="SyncContrastCheck" Content="RGB Contrast" Margin="0,0,0,8" Click="SyncOptionCheck_Click"/>
                    <CheckBox x:Name="SyncLutCheck" Content="Cineon Log LUT" Margin="0,0,0,8" Click="SyncOptionCheck_Click"/>
                    <CheckBox x:Name="SyncCropCheck" Content="裁剪" Margin="0,0,0,14" Click="SyncOptionCheck_Click"/>
                    <Grid>
                        <Button Content="取消" HorizontalAlignment="Left" Style="{StaticResource ToolbarNeutralButtonStyle}" Click="SyncCancel_Click"/>
                        <Button x:Name="SyncApplyBtn" Content="应用到 0 张" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="SyncApply_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
